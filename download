name: Sync registry data from Dropbox

on:
  workflow_dispatch:
  schedule:
    - cron: "*/5 * * * *"

permissions:
  contents: write

jobs:
  sync:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - name: Install Excel reader
        run: pip install openpyxl
      - name: Download the current Dropbox workbook and update site data
        env:
          # Вставьте сюда актуальную ссылку «Копировать ссылку» из Dropbox один раз.
          # При редактировании того же файла ссылка больше не меняется.
          DROPBOX_SHARED_URL: "ВСТАВЬТЕ_СЮДА_АКТУАЛЬНУЮ_ССЫЛКУ_DROPBOX"
        run: python scripts/sync_dropbox.py
      - name: Commit new data when it changed
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add data.js
          git diff --cached --quiet || git commit -m "Update registry data from Dropbox"
          git push
